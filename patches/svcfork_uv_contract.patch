+def _uv_masked_f0(f0, uv):
+    """Restore the f0==0 contract SineGen documents for unvoiced steps.
+
+    interpolate_f0() fills every unvoiced frame, so SineGen._f02uv
+    (voiced_threshold=0) returns uv==1 everywhere and
+    noise_amp = uv*0.003 + (1-uv)*sine_amp/3 is pinned at 0.003 - a ~20.9 dB
+    cut to the aperiodic excitation, on every frame. Masking f0 by the real uv
+    lets the unvoiced branch fire again.
+
+    OFF by default: the model was trained against the violated contract, so
+    enabling this at inference alone is a train/test mismatch. Set
+    SVCFORK_UV_CONTRACT=1 to enable (intended for retrains that also mask
+    during training).
+    """
+    if _os.environ.get("SVCFORK_UV_CONTRACT", "") != "1":
+        return f0
+    return f0 * uv
+
