# Keyshift conditioning for the so-vits-svc-fork VITS decoder.
#
# WHY: pitch-augmented copies are resampled, so their formants move with the
# pitch. With nowhere to attribute that, the model folds the warp into the
# speaker and identity drifts - measured on this voice, 0.983 -> 0.867 at +4
# semitones, below the 0.88 floor of her own held-out clips. DDSP-SVC solves
# this by CONDITIONING rather than correcting: feed the shift in as a learned
# embedding and zero it at inference. Neither so-vits-svc repo has f0
# augmentation for the VITS decoder (upstream 4.1's use_pitch_aug is in the
# diffusion template only and trains the refiner), so this is hand-written.
#
# SAFETY: emb_keyshift is nn.Linear(1, gin, bias=False) with a zero-init
# weight. keyshift 0 therefore contributes EXACTLY zero however the weight
# trains - so unshifted samples, every inference, and every pre-patch
# checkpoint behave bit-identically to the unpatched model.
#
# Verified: filename->semitone parsing incl. negatives; zero-contribution at
# keyshift=0 with a randomised weight; pre-patch G_*.pth still load_state_dict
# (only emb_keyshift.weight missing); collate returns 9 tensors and keyshift
# stays bound to its own sample through the length sort.
#
# GOTCHA found on real data: __getitem__'s random-crop loop slices every key on
# the time axis. keyshift is per-utterance, so it must be skipped there like
# `spk` - otherwise a long sample's keyshift becomes shape [0] and the collate
# stack dies with 'expects each tensor to be equal size'.

--- a/modules/synthesizers.py
+++ b/modules/synthesizers.py
@@ -184,8 +184,25 @@
         )
         self.emb_uv = nn.Embedding(2, hidden_channels)
 
-    def forward(self, c, f0, uv, spec, g=None, c_lengths=None, spec_lengths=None):
+        # Keyshift conditioning (DDSP-SVC's approach, ported to the VITS decoder).
+        # Pitch-augmented copies are resampled, so their FORMANTS move with the
+        # pitch. Without somewhere to put that, the model attributes the warp to
+        # the speaker and identity drifts (measured: 0.983 -> 0.867 at +4 st).
+        # Giving it an explicit axis lets it explain the warp without touching g.
+        #
+        # bias=False is load-bearing: keyshift 0 then contributes EXACTLY zero no
+        # matter what the weight learns, so unshifted samples - and every
+        # inference - are bit-identical to the unpatched model. Zero-init means
+        # the run also STARTS there, like the LoRA delta below.
+        self.emb_keyshift = nn.Linear(1, gin_channels, bias=False)
+        nn.init.zeros_(self.emb_keyshift.weight)
+
+    def forward(self, c, f0, uv, spec, g=None, c_lengths=None, spec_lengths=None, keyshift=None):
         g = self.emb_g(g).transpose(1, 2)
+        if keyshift is not None:
+            # [B,1] semitones -> [B,gin,1], added to the speaker conditioning so
+            # it reaches enc_q, flow, dec and the f0 decoder exactly as g does.
+            g = g + self.emb_keyshift(keyshift.to(g.dtype)).unsqueeze(-1)
         # ssl prenet
         x_mask = torch.unsqueeze(commons.sequence_mask(c_lengths, c.size(2)), 1).to(c.dtype)
         x = self.pre(c) * x_mask + self.emb_uv(uv.long()).transpose(1, 2)
