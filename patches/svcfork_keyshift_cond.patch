+_KS_RE = re.compile(r"_(?:ks|up)(-?\d+)")
+
+
+def _keyshift_of(path) -> float:
+    """Semitones this file was pitch-shifted by, read from its name.
+
+    Augmented copies are written as ``*_ks4.wav`` / ``*_up2.wav``. Anything
+    unmarked is 0, so an ordinary corpus trains exactly as before.
+    """
+    m = _KS_RE.search(str(path))
+    return float(m.group(1)) if m else 0.0
