+class DiscriminatorR(torch.nn.Module):
+    """Single-resolution STFT sub-discriminator: 2D convs over |STFT(x)|.
+
+    Standard multi-resolution-discriminator design (as in the published
+    MRD/UnivNet-family vocoder-GAN literature and its many open reimplementations),
+    operating on magnitude spectra at several (n_fft, hop, win) resolutions rather
+    than on periodic-reshaped or scale-pooled waveforms like DiscriminatorP/S. Shares
+    their (x, fmap) return contract so it drops into the existing generic loss
+    functions and MultiPeriodDiscriminator's own forward loop unchanged.
+    """
+
+    def __init__(self, resolution, use_spectral_norm=False):
+        super().__init__()
+        self.resolution = resolution  # (n_fft, hop_length, win_length)
+        norm_f = weight_norm if use_spectral_norm == False else spectral_norm
+        self.convs = nn.ModuleList(
+            [
+                norm_f(Conv2d(1, 32, (3, 9), padding=(1, 4))),
+                norm_f(Conv2d(32, 32, (3, 9), stride=(1, 2), padding=(1, 4))),
+                norm_f(Conv2d(32, 32, (3, 9), stride=(1, 2), padding=(1, 4))),
+                norm_f(Conv2d(32, 32, (3, 9), stride=(1, 2), padding=(1, 4))),
+                norm_f(Conv2d(32, 32, (3, 3), padding=(1, 1))),
+            ]
+        )
+        self.conv_post = norm_f(Conv2d(32, 1, (3, 3), padding=(1, 1)))
+
+    def spectrogram(self, x):
+        n_fft, hop_length, win_length = self.resolution
+        x = F.pad(x, (int((n_fft - hop_length) / 2), int((n_fft - hop_length) / 2)), mode="reflect")
+        x = x.squeeze(1)
+        # torch.stft's complex path needs fp32; the rest of this fork trains in
+        # fp32 anyway (fp16_run/bf16_run are both false in every config touched
+        # this session), so this is belt-and-suspenders, not a new constraint.
+        # Hann, matching mel_processing.py's own spectrogram_torch elsewhere
+        # in this fork - a rectangular default window has worse spectral
+        # leakage, undesirable input for a discriminator judging spectral
+        # realism.
+        window = torch.hann_window(win_length, device=x.device, dtype=torch.float32)
+        with torch.autocast(device_type=x.device.type if x.device.type != "cpu" else "cpu", enabled=False):
+            mag = torch.stft(
+                x.float(), n_fft=n_fft, hop_length=hop_length, win_length=win_length,
+                window=window, center=False, return_complex=True,
+            ).abs()
+        return mag.unsqueeze(1)  # [B, 1, F, T]
+
+    def forward(self, x):
+        fmap = []
+        x = self.spectrogram(x)
+        for l in self.convs:
+            x = l(x)
+            x = F.leaky_relu(x, modules.LRELU_SLOPE)
+            fmap.append(x)
+        x = self.conv_post(x)
+        fmap.append(x)
+        x = torch.flatten(x, 1, -1)
+        return x, fmap
+
