+class MultiPeriodDiscriminatorWithMRD(MultiPeriodDiscriminator):
+    """MultiPeriodDiscriminator + a multi-resolution STFT discriminator.
+
+    Appends the new sub-discriminators to the SAME ``self.discriminators``
+    ModuleList the parent class builds, rather than nesting them under a new
+    submodule name. That keeps every original entry's state_dict key
+    (``discriminators.0.*`` .. ``discriminators.5.*``) byte-identical to an
+    unmodified MultiPeriodDiscriminator checkpoint, so this fork's own
+    ``safe_load``/``_substitute_if_same_shape`` (utils.py) loads a pretrained or
+    fine-tuned MPD-only checkpoint's matching keys automatically and leaves
+    only the new resolutions (indices 6+) at their fresh init - no manual key
+    remapping needed. ``forward()`` is inherited unchanged: the parent's loop
+    over ``self.discriminators`` only relies on each entry returning
+    ``(x, fmap)``, which DiscriminatorR does too.
+
+    Added to address the researched, evidence-backed gap in this fork's
+    discriminator set: only MPD (which itself bundles one DiscriminatorS) is
+    ever instantiated in train.py. The separate MultiScaleDiscriminator class
+    in this same file is never imported there - genuinely dead code, not a
+    second discriminator already in use. No multi-resolution/time-frequency
+    discriminator exists anywhere in this fork.
+    """
+
+    def __init__(
+        self,
+        use_spectral_norm=False,
+        resolutions=((1024, 120, 600), (2048, 240, 1200), (512, 50, 240)),
+    ):
+        super().__init__(use_spectral_norm)
+        self.discriminators.extend(DiscriminatorR(r, use_spectral_norm) for r in resolutions)
